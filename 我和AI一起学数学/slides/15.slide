<Slide style={{ width: 1280, height: 720, background: '#FFF8F0', padding: 60, fontFamily: "'Microsoft YaHei', sans-serif", position: 'relative' }}>
  {/* 背景装饰 */}
  <Box style={{ position: 'absolute', top: -70, left: -70, width: 240, height: 240, borderRadius: 120, background: '#FFC93C', opacity: 0.14 }} />
  <Box style={{ position: 'absolute', bottom: -80, right: -60, width: 260, height: 260, borderRadius: 130, background: '#2BB3A3', opacity: 0.12 }} />
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 56, width: '100%', height: '100%' }}>
    <Box style={{ width: 600 }}>
      <Image src="assets/hero_end.png" style={{ width: 600, height: 400, objectFit: 'cover', borderRadius: 28, boxShadow: '0 8px 32px rgba(51,48,46,0.18)' }} />
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 30 }}>
      <Text style={{ fontSize: 54, fontWeight: 'bold', color: '#33302E', lineHeight: 1.3 }}>
        AI 是我的<span style={{ color: '#F97316' }}>学习小伙伴</span>
      </Text>
      <Text style={{ fontSize: 30, color: '#33302E', lineHeight: 1.55 }}>
        它不替我思考，<br />它让思考变得<span style={{ fontWeight: 'bold', color: '#2BB3A3' }}>好玩</span>！
      </Text>
      <Text style={{ fontSize: 64, fontWeight: 'bold', backgroundImage: 'linear-gradient(135deg, #F97316 0%, #FFC93C 100%)', backgroundClip: 'text', color: 'transparent' }}>
        谢谢大家！
      </Text>
    </Box>
  </Box>
</Slide>
